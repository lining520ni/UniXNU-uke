# Bootstrap pass: build the base 4 KiB XNU and a prelinked candidate with
# no device archives. This produces the compile records and the original-class
# candidate the device archives are built against.
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# CONFIG_XNU_SOURCE_CORECRYPTO14 is not set
# CONFIG_XNU_SOURCE_PTHREAD is not set
# CONFIG_XNU_ARM_DT_PLATFORM is not set
# CONFIG_XNU_ARMCPU is not set
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
# CONFIG_XNU_NATIVE_UFS is not set
# CONFIG_XNU_NATIVE_AES is not set
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set
# CONFIG_XNU_SHENG_PMGR is not set
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_BOOT_PROGRESS is not set
# CONFIG_XNU_VERIFIED_ROOT_PROBE is not set
# CONFIG_XNU_SOURCE_MOCKFS is not set

# The arm64 arch fragment forces CONFIG_XNU_NATIVE_ARCH_TIMER=y for every configuration, but this
# bootstrap pass links without any device archives, so there is no ArmCpu interrupt provider and
# build-xnu-4k-baseline.sh refuses the mismatch. The board's archive list is not run in this pass
# either: it needs the candidate that this pass produces.
# CONFIG_XNU_NATIVE_ARCH_TIMER is not set
# CONFIG_XNU_BUILD_ARCHIVES is not set